      "type": "n8n-nodes-base.microsoftOutlookTrigger",
      "typeVersion": 1,
      "position": [
        200,
        920
      ],
      "id": "d3e4f5a6-7b8c-9d0e-1f2a-3b4c5d6e7f8a",
      "name": "1C. Microsoft Outlook 监听入口 (Office 365 & 个人 Outlook/Hotmail)",
      "credentials": {
        "microsoftOutlookOAuth2Api": {
          "id": "outlook_cred_1",
          "name": "Outlook / Office 365 授权"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// 0. 统一不同邮件来源的数据格式，并注入渠道标签\nconst item = $input.first();\nconst json = item.json;\nconst binaries = item.binary || {};\n\n// 识别来源\nlet provider = 'imap';\nlet senderEmail = '';\nlet recipientEmail = '';\nlet subject = json.subject || '';\nlet bodyText = '';\n\nif (json.threadId || json.historyId) {\n  // 1. 来自 Gmail Trigger\n  provider = 'gmail';\n  const fromObj = json.from && json.from.value ? json.from.value[0] : {};\n  senderEmail = fromObj.address || json.from || '';\n  recipientEmail = json.to || '';\n  bodyText = json.textPlain || json.snippet || '';\n} else if (json.internetMessageId || json.conversationId || json.bodyPreview !== undefined) {\n  // 2. 来自 Microsoft Outlook / Office 365 Trigger\n  provider = 'outlook';\n  senderEmail = json.from?.emailAddress?.address || json.sender?.emailAddress?.address || '';\n  recipientEmail = json.toRecipients?.[0]?.emailAddress?.address || '';\n  bodyText = json.bodyPreview || (json.body?.content ? json.body.content.replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim() : '');\n} else {\n  // 3. 来自 通用 IMAP Trigger (腾讯企邮、阿里、网易企业邮，以及 QQ、163/126 等个人邮箱)\n  provider = 'imap';\n  senderEmail = json.from?.text || json.from?.value?.[0]?.address || json.from || '';\n  recipientEmail = json.to?.text || json.to?.value?.[0]?.address || json.to || '';\n  bodyText = json.text || json.textAsHtml || '';\n}\n\nif (!bodyText && json.html) {\n  bodyText = json.html.replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim();\n}\n\nreturn [{\n  json: {\n    ...json,\n    emailProvider: provider,\n    senderEmail,\n    recipientEmail,\n    subject,\n    cleanBodyText: bodyText\n  },\n  binary: binaries\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        680
      ],
      "id": "1f2e3d4c-5b6a-7980-ba98-fedcba098765",
      "name": "0. 多邮箱协议归一化与渠道打标"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.subject }}",
              "operation": "regex",
              "value2": "(?i)(底价|底價|更新底价|更新底價|底价表|底價表|PRICING.*UPDATE|UPDATE.*PRICING|COST.*SHEET|INTERNAL.*PRICE)"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        720,
        680
      ],
      "id": "2a8f2451-7b60-4b5d-9130-2ecb175187dd",
      "name": "2. 严格判定邮件类型 (防海外买家询盘误杀)"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.KELVINFLOW_URL || 'https://quote.kelvinflow.com' }}/api/v1/update-pricing",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-tenant-id",
              "value": "={{ $env.TENANT_ID || 'default' }}"
            },
            {
              "name": "x-api-key",
              "value": "={{ $env.TENANT_API_KEY || 'key_default_admin_2026' }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "pricing_file",
              "inputDataFieldName": "attachment_0"
            },
            {
              "name": "sender_email",
              "value": "={{ $json.senderEmail }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        960,
        520
      ],
      "id": "005a1d4c-699f-4ffd-ac3d-390161759bdd",
      "name": "3A. 更新底价库 (/update-pricing)"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst binaries = item.binary || {};\nconst json = item.json;\nconst binaryKeys = Object.keys(binaries);\nlet bestKey = null;\n\n// 1. 优先查找真正的采购单 (PDF 或 Excel)\nfor (const key of binaryKeys) {\n  const file = binaries[key];\n  const name = (file.fileName || '').toLowerCase();\n  if (name.endsWith('.pdf') || name.endsWith('.xlsx') || name.endsWith('.xls') || name.endsWith('.csv')) {\n    bestKey = key;\n    break;\n  }\n}\n\n// 2. 查找真实商品图片 (智能过滤小于 25KB 的企业签名与 Logo 杂图)\nif (!bestKey) {\n  for (const key of binaryKeys) {\n    const file = binaries[key];\n    const name = (file.fileName || '').toLowerCase();\n    const isImage = name.endsWith('.png') || name.endsWith('.jpg') || name.endsWith('.jpeg') || (file.mimeType || '').startsWith('image/');\n    const isSignature = name.includes('logo') || name.includes('icon') || name.includes('avatar') || name.includes('sig') || name.includes('image001');\n    const size = file.fileSize ? parseInt(file.fileSize, 10) : (file.data ? file.data.length * 0.75 : 0);\n    \n    if (isImage && (!isSignature || size > 25000)) {\n      bestKey = key;\n      break;\n    }\n  }\n}\n\nlet poText = json.cleanBodyText || '';\n\n// 3. 针对个人邮箱（如QQ邮箱、163/126网易邮箱）中转超大附件 (微云/网易网盘) 的智能检测与标记\nconst cloudAttachmentMatches = poText.match(/(https?:\\/\\/(?:share\\.weiyun\\.com|mail\\.qq\\.com\\/cgi-bin\\/ftnExs_download|mail\\.163\\.com\\/netfolder\\/download)[^\\s\"'>]+)/gi);\nif (cloudAttachmentMatches && cloudAttachmentMatches.length > 0) {\n  poText += `\\n\\n[系统检测提示: 发件方通过QQ微云/网易中转站发送了超大附件链接: ${cloudAttachmentMatches[0]}]`;\n}\n\nconst outBinary = {};\nif (bestKey && binaries[bestKey]) {\n  outBinary.po_file = binaries[bestKey];\n}\n\nreturn [{\n  json: {\n    ...json,\n    has_po_file: !!bestKey,\n    po_text: poText\n  },\n  binary: outBinary\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        800
      ],
      "id": "5c8d3e21-3a1b-4f90-8c23-7a912e4b8899",
      "name": "2B. 智能附件筛选与纯文本提取"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.KELVINFLOW_URL || 'https://quote.kelvinflow.com' }}/api/v1/process-quote",
        "sendHeaders": true,
        "headerParameters": {
