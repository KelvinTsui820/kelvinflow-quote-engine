      "id": "1187fc41-be6c-43da-b905-5b4e65ca968d",
      "name": "3B. 询盘报价计算 (/process-quote)"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst resp = item.json;\n\nif (!resp.success) {\n  throw new Error(`报价生成失败: ${resp.error}`);\n}\n\nconst quoteId = resp.quotation?.quotationNumber || 'QT-UNKNOWN';\nconst reviewUrl = resp.reviewUrl || `https://quote.kelvinflow.com/`;\n\nreturn [{\n  json: {\n    ...item.json,\n    quotation: resp.quotation,\n    draftEmail: resp.draftEmail,\n    reviewUrl: reviewUrl\n  },\n  binary: {\n    data: {\n      data: resp.pdfBase64,\n      mimeType: 'application/pdf',\n      fileName: resp.draftEmail?.pdfFileName || `${quoteId}_Official_Quotation.pdf`\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        800
      ],
      "id": "79b56060-7f14-40f7-85e5-a76a8589f99c",
      "name": "4B. 转化 PDF 二进制与审核链接"
    },
