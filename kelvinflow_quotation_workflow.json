      "name": "3A. 更新底價庫 (/update-pricing)"
    },
    {
      "parameters": {
        "sendTo": "={{ $('1. Gmail Trigger (監聽附件與詢盤郵件)').item.json.from }}",
        "subject": "={{ $json.replyEmail.subject || '底價庫更新狀態通知' }}",
        "message": "={{ $json.replyEmail.body || $json.error }}",
        "options": {}
