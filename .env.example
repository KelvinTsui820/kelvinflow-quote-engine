# 服務端口
PORT=3000

# Google Gemini API 密鑰 (必填)
GEMINI_API_KEY=your_gemini_api_key_here

# 模型路由分級配置
DEFAULT_AI_MODEL=gemini-3.7-flash
FALLBACK_AI_MODEL=gemini-3.1-pro
AI_CONFIDENCE_THRESHOLD=80

# 業務默認配置
DEFAULT_PROFIT_MARGIN=0.3
DEFAULT_FOB_COST=0
DEFAULT_FALLBACK_RATE=7.2
COMPANY_NAME=FoShan Kelvin Foreign Trade Co., Ltd.
DEFAULT_MANAGER_NAME=Kelvin Tsui
DEFAULT_MANAGER_EMAIL=sales@yourcompany.com
